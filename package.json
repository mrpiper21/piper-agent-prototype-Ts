{
  "name": "printmyfile-agent",
  "version": "1.1.7",
  "description": "PrintMyFile SaaS Local Print Agent",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron dist/main/index.js",
    "start:built": "electron dist/main/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "package": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "package:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "publish": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish always",
    "publish:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --publish always",
    "publish:mac": "npm run build && electron-builder --mac --publish always",
    "publish:linux": "npm run build && electron-builder --linux --publish always",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "clean": "rimraf dist",
    "prebuild": "npm run clean"
  },
  "keywords": [
    "printing",
    "saas",
    "agent",
    "cups",
    "printer",
    "typescript"
  ],
  "author": {
    "name": "Bernard Baah",
    "email": "benbaah104@gmail.com"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/pdfmake": "^0.2.12",
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "dotenv": "^16.3.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "fs-extra": "^11.2.0",
    "immer": "^10.0.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "leaflet": "^1.9.4",
    "node-cron": "^3.0.3",
    "ora": "^8.0.1",
    "pdfmake": "^0.2.20",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.20.0",
    "update-electron-app": "^3.1.1",
    "uuid": "^9.0.1",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-vite": "^2.0.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "rimraf": "^5.0.5",
    "terser": "^5.26.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.printmyfile.agent",
    "productName": "PrintMyFile Agent",
    "publish": {
      "provider": "github",
      "owner": "mrpiper21",
      "repo": "piper-agent-prototype-Ts",
      "private": false,
      "releaseType": "release"
    },
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "PrintMyFile",
      "sign": null
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "sign": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "support@printmyfile.com"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    }
  }
}
