{
  "name": "printmyfile-agent",
  "version": "1.0.0",
  "description": "PrintMyFile SaaS Local Print Agent",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron dist/main/index.js",
    "start:built": "electron dist/main/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "package": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "package:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "clean": "rimraf dist",
    "prebuild": "npm run clean"
  },
  "keywords": [
    "printing",
    "saas",
    "agent",
    "cups",
    "printer",
    "typescript"
  ],
  "author": "PrintMyFile",
  "license": "UNLICENSED",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.2.0",
    "node-cron": "^3.0.3",
    "ora": "^8.0.1",
    "uuid": "^9.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "@tanstack/react-query": "^5.0.0",
    "zustand": "^4.4.0",
    "electron-log": "^5.0.0",
    "electron-updater": "^6.1.0",
    "immer": "^10.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "electron": "^28.0.0",
    "electron-vite": "^2.0.0",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "rimraf": "^5.0.5",
    "terser": "^5.26.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.printmyfile.agent",
    "productName": "PrintMyFile Agent",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "forceCodeSigning": false,
      "verifyUpdateCodeSignature": false
    },
    "forceCodeSigning": false
  }
}
