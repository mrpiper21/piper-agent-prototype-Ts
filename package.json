{
  "name": "printmyfile-agent",
  "version": "1.0.0",
  "description": "PrintMyFile SaaS Local Print Agent",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "install": "tsx src/cli/install-command.ts",
    "status": "tsx src/cli/status-command.ts",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "build:windows": "tsx scripts/build-windows.ts",
    "build:macos": "tsx scripts/build-macos.ts",
    "build:linux": "tsx scripts/build-linux.ts",
    "build:all": "npm run build:windows && npm run build:macos && npm run build:linux",
    "sign": "tsx scripts/sign-executable.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "rimraf dist",
    "prebuild": "npm run clean"
  },
  "keywords": [
    "printing",
    "saas",
    "agent",
    "cups",
    "printer",
    "typescript"
  ],
  "author": "PrintMyFile",
  "license": "PROPRIETARY",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.2.0",
    "node": "^24.10.0",
    "node-cron": "^3.0.3",
    "ora": "^8.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/chokidar": "^2.1.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "pkg": "^5.11.0",
    "rimraf": "^5.0.5",
    "terser": "^5.26.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
