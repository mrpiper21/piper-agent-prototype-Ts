# ============================================================================
# PrintMyFile Agent Environment Configuration
# ============================================================================
# Copy this file to .env and configure your settings

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# API Base URL - Backend server URL (default: production server)
# Set to http://localhost:3000/api for local development
API_BASE_URL=https://piper-server-prototype-ts.onrender.com/api

# Cloud server URL - Your PrintMyFile cloud server endpoint
CLOUD_URL=https://api.printmyfile.com

# Print API URL - Specific URL for print API (optional, defaults to API_BASE_URL/api/print)
# PRINT_API_URL=https://piper-server-prototype-ts.onrender.com/api/print

# Agent ID - Unique identifier for this agent (provided by PrintMyFile)
AGENT_ID=your-agent-id-here

# API Key - Your authentication key (provided by PrintMyFile)
API_KEY=your-api-key-here

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Location name - Human-readable name for this agent location
LOCATION_NAME=Default Location

# Log level - Controls logging verbosity (debug, info, warn, error)
LOG_LEVEL=info

# Enable file logging (true/false)
LOG_FILE=true

# Enable console logging (true/false)
LOG_CONSOLE=true

# ============================================================================
# TIMING CONFIGURATION
# ============================================================================

# Poll interval - How often to check for new jobs (milliseconds)
POLL_INTERVAL=5000

# Heartbeat interval - How often to send heartbeat to cloud (milliseconds)
HEARTBEAT_INTERVAL=30000

# File watch interval - How often to check for file tampering (milliseconds)
FILE_WATCH_INTERVAL=60000

# ============================================================================
# DIRECTORY CONFIGURATION
# ============================================================================

# Download directory - Where to store downloaded files
DOWNLOAD_DIR=./downloads

# Log directory - Where to store log files
LOG_DIR=./logs

# Configuration directory - Where to store configuration files
CONFIG_DIR=./.config

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Maximum retry attempts for failed operations
MAX_RETRY_ATTEMPTS=3

# Download timeout - Maximum time to wait for file downloads (milliseconds)
DOWNLOAD_TIMEOUT=30000

# Maximum log file size before rotation (bytes)
MAX_LOG_SIZE=10485760

# Maximum number of log files to keep
MAX_LOG_FILES=5

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Enable tamper detection (true/false)
ENABLE_TAMPER_DETECTION=true

# Enable file watching (true/false)
ENABLE_FILE_WATCHER=true

# Enable encryption (true/false)
ENABLE_ENCRYPTION=true

# License key - Optional license key for premium features
LICENSE_KEY=

# ============================================================================
# GITHUB AUTO-UPDATE SETTINGS (Private Repositories)
# ============================================================================

# GitHub Personal Access Token - Required for auto-updates in private repositories
# Create a token at: https://github.com/settings/tokens
# Required scopes: repo (Full control of private repositories)
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here

# GitHub Repository Owner (optional, defaults to package.json build.publish.owner)
# GITHUB_REPO_OWNER=mrpiper21

# GitHub Repository Name (optional, defaults to package.json build.publish.repo)
# GITHUB_REPO_NAME=piper-agent-prototype-Ts

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Node environment - Set to 'development' for development mode
NODE_ENV=production

# Enable debug mode (true/false)
DEBUG=false

# Enable performance monitoring (true/false)
ENABLE_PERFORMANCE_MONITORING=false
