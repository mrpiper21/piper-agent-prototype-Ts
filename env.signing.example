# Code Signing Configuration Example
# 
# Copy this file to .env and fill in your certificate details
# NEVER commit .env or certificate files to version control!

# Windows Code Signing Certificate (PFX file)
# Path to your .pfx certificate file
WIN_CERT_FILE=C:\path\to\your\certificate.pfx

# Certificate password
WIN_CERT_PASSWORD=YourSecurePasswordHere

# Alternative: If using Windows Certificate Store (EV certificates)
# Leave WIN_CERT_FILE and WIN_CERT_PASSWORD empty/unset
# The certificate will be auto-discovered from the Windows Certificate Store

